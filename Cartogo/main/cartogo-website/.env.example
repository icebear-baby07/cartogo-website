# Use a URL and public key from the same Supabase project.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
# Required for owner-approved administrator account changes and the one-time data migration.
# Keep this server-only; never expose it through config.js or browser code.
SUPABASE_SERVICE_ROLE_KEY=

SMTP_USER=target-email-address
SMTP_APP_PASSWORD=generated-from-google-app/passwords.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM=same-to-the-target-email-address
# Set to 127.0.0.1 to limit access to this computer; use 0.0.0.0 for LAN testing.
HOST=0.0.0.0
PORT=8002

# Server-side MongoDB connection and public site-data collections.
MONGODB_URI=
MONGODB_DATABASE=cartogo
MONGODB_UNITS_COLLECTION=vehicles
MONGODB_SITE_ASSETS_COLLECTION=site_assets
MONGODB_SITE_CONTENT_COLLECTION=site_content
MONGODB_INQUIRIES_COLLECTION=inquiries
MONGODB_SEQUENCES_COLLECTION=site_sequences
# Gmail app-password SMTP settings used for owner approval PINs.
