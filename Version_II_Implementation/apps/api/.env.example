SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=(Supabase Secret key or legacy service_role key; API only)
CARTOGO_INITIAL_OWNER_EMAIL=(Email ni owner ng Cartogo)
SMTP_USER=(A dedicated email address for sending emails.)
SMTP_APP_PASSWORD=(Replace my google app password with your own app password generated from your email provider.)
//Additionally, check on how to make an app password using online tutorials. The format should be the same as with what is inside the .env file in api folder.
SMTP_HOST=
SMTP_PORT=
SMTP_FROM=
GEOCODING_CONTACT_EMAIL=(optional)
BOOKING_SMTP_FROM=(Optional sender address for customer booking emails; not the recipient)